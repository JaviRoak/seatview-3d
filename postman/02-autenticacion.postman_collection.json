{
  "info": {
    "_postman_id": "246f19b4-6bf1-53ad-aafe-83a9587f0737",
    "name": "SeatView 3D | 02 - Autenticación",
    "description": "Colección modular importable en Postman. Parte 2/8. Configurar variables de colección según entorno; las variables de una colección no se sincronizan automáticamente con otras.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "02 - Autenticación",
      "item": [
        {
          "name": "POST Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Un email solo se puede registrar una vez; cambie registerEmail al repetir.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"name\": \"{{registerName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const d=pm.response.json();",
                  "  pm.collectionVariables.set(\"userToken\",d.token);",
                  "}"
                ]
              }
            }
          ]
        },
