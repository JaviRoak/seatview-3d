{
  "info": {
    "_postman_id": "3e7801d0-3d11-5e8a-ab6f-0a6d8b85429b",
    "name": "SeatView 3D | 05 - Pagos simulados",
    "description": "Colección modular importable en Postman. Parte 5/8. Configurar variables de colección según entorno; las variables de una colección no se sincronizan automáticamente con otras.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "05 - Pagos simulados",
      "item": [
        {
          "name": "GET Tarjetas de prueba",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/test-cards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "test-cards"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const d=pm.response.json();",
                  "  pm.test(\"Tarjetas presentes\",()=>pm.expect(d.ok).to.exist);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Checkout aprobado [MODIFICA DATOS]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "checkout"
              ]
            },
            "description": "IRREVERSIBLE en la base de pruebas: crea orden, marca asiento SOLD y genera boleto. Requiere bloqueo vigente del mismo usuario.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventSeatIds\": [\n    \"{{eventSeatId}}\"\n  ],\n  \"card\": {\n    \"holder\": \"Usuario de Pruebas\",\n    \"number\": \"4242424242424242\",\n    \"expMonth\": 12,\n    \"expYear\": 2030,\n    \"cvc\": \"123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const d=pm.response.json();",
                  "  pm.test(\"Orden creada\",()=>pm.expect(d.order).to.exist);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Checkout rechazado [GENERA ORDEN FAILED]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "payments",
                "checkout"
              ]
            },
            "description": "Requiere un bloqueo activo; crea orden FAILED sin vender el asiento.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventSeatIds\": [\n    \"{{eventSeatId}}\"\n  ],\n  \"card\": {\n    \"holder\": \"Usuario de Pruebas\",\n    \"number\": \"4000000000000002\",\n    \"expMonth\": 12,\n    \"expYear\": 2030,\n    \"cvc\": \"123\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 402\", () => pm.response.to.have.status(402));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
