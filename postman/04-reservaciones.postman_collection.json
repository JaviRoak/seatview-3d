        {
          "name": "POST Reservar zona general",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locks/zone",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "locks",
                "zone"
              ]
            },
            "description": "Solo zonas GA. Guarda primer asiento reservado; el checkout puede consumirlo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"zoneId\": \"{{zoneId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });",
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const d=pm.response.json();",
                  "  if (d.locks && d.locks.length) pm.collectionVariables.set(\"eventSeatId\",d.locks[0].eventSeatId);",
                  "}"
                ]
              }
            }
          ]
        }
