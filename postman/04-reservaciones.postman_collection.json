    {
      "name": "04 - Bloqueos temporales (JWT USER)",
      "item": [
        {
          "name": "POST Bloquear asiento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/locks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "locks"
              ]
            },
            "description": "Usar asiento numerado AVAILABLE; reusar antes de su expiración para renovarlo.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"eventSeatId\": \"{{eventSeatId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Respuesta JSON\", () => { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        },
