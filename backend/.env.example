# Copia este archivo a backend/.env (y frontend/.env.example a frontend/.env).
# Nunca subas .env al repositorio.

# ---------- backend/.env ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://seatview:seatview@localhost:5432/seatview
REDIS_URL=redis://localhost:6379
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
TICKET_SECRET=otro-secreto-distinto-para-firmar-boletos
# Orígenes permitidos (lista separada por coma). Con el proxy de Vite basta el del frontend.
# En producción añade el dominio de Vercel: https://seatview.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Bloqueo temporal de asientos
LOCK_TTL_SECONDS=300
MAX_LOCKS_PER_USER=6
# keyspace = notificaciones de Redis + barrido de respaldo · sweep = solo barrido (ver docs/concurrencia.md)
LOCK_EXPIRY_STRATEGY=keyspace
LOCK_SWEEP_INTERVAL_MS=5000
# Correo: console (simulado, por defecto) | ethereal (cuenta de prueba con vista previa) | smtp (real)
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SeatView 3D <no-reply@seatview.local>"

# ---------- frontend/.env ----------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
# Tamaño máximo de imágenes subidas por administradores (bytes)
UPLOAD_MAX_BYTES=2097152
