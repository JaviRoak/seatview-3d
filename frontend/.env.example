# URL del backend (API REST) y del servidor de Socket.io.
# VACÍO = mismo origen que el frontend, a través del proxy de Vite (/api, /uploads, /socket.io).
# Solo se rellenan cuando el backend vive en OTRO dominio (p. ej. producción: frontend en
# Vercel y backend en Railway → https://mi-api.up.railway.app).
VITE_API_URL=
VITE_SOCKET_URL=

# Destino del proxy de desarrollo (solo lo usa vite.config.ts). Usa 127.0.0.1, no localhost.
BACKEND_ORIGIN=http://127.0.0.1:4000

# URL pública del sitio, sin "/" final (p. ej. https://seatview-3d.vercel.app). La usa el build para
# generar sitemap.xml y la línea Sitemap de robots.txt. En Vercel puede ir vacía: se toma el dominio
# de producción del proyecto (VERCEL_PROJECT_PRODUCTION_URL).
VITE_SITE_URL=
